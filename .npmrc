# Next 16 (preview) ainda não está no range de peer do next-auth v5 beta
# (peer: next ^14||^15||^16.0.0, e prerelease não casa com ^16.0.0).
# Mantemos a resolução tolerante para todo install (local e Vercel),
# alinhada à Golden Stack (Next 16 preview). Revisar quando next-auth
# suportar Next 16 estável.
legacy-peer-deps=true
